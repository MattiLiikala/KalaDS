{
  "name": "@kalads/spec",
  "version": "0.1.1",
  "type": "module",
  "description": "The shared component API (prop types, variants, defaults) of the KalaDS web, React and React Native libraries.",
  "keywords": [
    "kalads",
    "design-system",
    "types",
    "component-api"
  ],
  "license": "MIT",
  "author": "Matti Liikala",
  "homepage": "https://kalads.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattiLiikala/KalaDS.git",
    "directory": "packages/spec"
  },
  "bugs": {
    "url": "https://github.com/MattiLiikala/KalaDS/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node scripts/generate.mjs",
    "build": "tsc --project tsconfig.json",
    "typecheck": "node scripts/generate.mjs && tsc --noEmit",
    "clean": "rm -rf dist src/generated.ts"
  },
  "devDependencies": {
    "@kalads/web-components": "workspace:*",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
