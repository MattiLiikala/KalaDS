{
  "component": {
    "link": {
      "text":                  { "$type": "color",      "$value": "{semantic.text.link}" },
      "text-hover":            { "$type": "color",      "$value": "{semantic.text.link-hover}" },
      "text-active":           { "$type": "color",      "$value": "{semantic.text.link-active}" },
      "text-subtle":           { "$type": "color",      "$value": "{semantic.text.default}" },
      "text-subtle-hover":     { "$type": "color",      "$value": "{semantic.text.link}" },
      "underline-width":       { "$type": "dimension",  "$value": "{semantic.border-width.default}" },
      "underline-width-hover": { "$type": "dimension",  "$value": "{semantic.border-width.strong}" },
      "icon-size":             { "$type": "dimension",  "$value": "{semantic.spacing.md}" },
      "icon-gap":              { "$type": "dimension",  "$value": "{semantic.spacing.xs}" },
      "radius":                { "$type": "dimension",  "$value": "{semantic.radius.sm}" },
      "ring-focus":            { "$type": "color",      "$value": "{semantic.interactive.focus}" },
      "ring-width":            { "$type": "dimension",  "$value": "{semantic.border-width.ring}" },
      "ring-offset":           { "$type": "dimension",  "$value": "{semantic.border-width.ring-offset}" }
    }
  }
}
