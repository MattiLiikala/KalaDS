{
  "component": {
    "autocomplete": {
      "bg":                   { "$type": "color",      "$value": "{semantic.bg.default}" },
      "bg-disabled":          { "$type": "color",      "$value": "{semantic.bg.subtle}" },
      "text":                 { "$type": "color",      "$value": "{semantic.text.default}" },
      "text-placeholder":     { "$type": "color",      "$value": "{semantic.text.muted}" },
      "text-disabled":        { "$type": "color",      "$value": "{semantic.text.muted}" },
      "border":               { "$type": "color",      "$value": "{semantic.border.control}" },
      "border-hover":         { "$type": "color",      "$value": "{semantic.border.control-hover}" },
      "border-focus":         { "$type": "color",      "$value": "{semantic.border.interactive}" },
      "border-error":         { "$type": "color",      "$value": "{semantic.border.status-danger}" },
      "border-error-focus":   { "$type": "color",      "$value": "{semantic.border.status-danger}" },
      "border-disabled":      { "$type": "color",      "$value": "{semantic.border.disabled}" },
      "border-width":         { "$type": "dimension",  "$value": "{semantic.border-width.default}" },
      "border-width-focus":   { "$type": "dimension",  "$value": "{semantic.border-width.focus}" },
      "radius":               { "$type": "dimension",  "$value": "{semantic.radius.md}" },
      "padding-x":            { "$type": "dimension",  "$value": "{semantic.padding.md}" },
      "padding-y":            { "$type": "dimension",  "$value": "{semantic.padding.sm}" },
      "icon":                 { "$type": "color",      "$value": "{semantic.text.subtle}" },
      "label-text":           { "$type": "color",      "$value": "{semantic.text.default}" },
      "helper-text":          { "$type": "color",      "$value": "{semantic.text.subtle}" },
      "error-text":           { "$type": "color",      "$value": "{semantic.text.status-danger}" },
      "popup-bg":             { "$type": "color",      "$value": "{semantic.bg.default}" },
      "popup-border":         { "$type": "color",      "$value": "{semantic.border.default}" },
      "popup-border-width":   { "$type": "dimension",  "$value": "{semantic.border-width.default}" },
      "popup-radius":         { "$type": "dimension",  "$value": "{semantic.radius.md}" },
      "popup-padding":        { "$type": "dimension",  "$value": "{semantic.spacing.xs}" },
      "popup-shadow":         { "$type": "shadow",     "$value": "{semantic.shadow.soft.2}" },
      "popup-offset":         { "$type": "dimension",  "$value": "{semantic.spacing.xs}" },
      "popup-max-height":     { "$type": "dimension",  "$value": "{semantic.size.lg}" },
      "option-text":          { "$type": "color",      "$value": "{semantic.text.default}" },
      "option-bg-hover":      { "$type": "color",      "$value": "{semantic.bg.subtle}" },
      "option-bg-active":     { "$type": "color",      "$value": "{semantic.bg.interactive-subtle}" },
      "option-text-active":   { "$type": "color",      "$value": "{semantic.text.on-interactive-subtle}" },
      "option-text-disabled": { "$type": "color",      "$value": "{semantic.text.muted}" },
      "option-radius":        { "$type": "dimension",  "$value": "{semantic.radius.sm}" },
      "option-padding-x":     { "$type": "dimension",  "$value": "{semantic.padding.md}" },
      "option-padding-y":     { "$type": "dimension",  "$value": "{semantic.padding.sm}" },
      "empty-text":           { "$type": "color",      "$value": "{semantic.text.muted}" }
    }
  }
}
