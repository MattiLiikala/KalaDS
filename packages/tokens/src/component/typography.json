{
  "component": {
    "typography": {
      "color-default": { "$type": "color",      "$value": "{semantic.text.default}" },
      "color-subtle":  { "$type": "color",      "$value": "{semantic.text.subtle}" },
      "color-muted":   { "$type": "color",      "$value": "{semantic.text.muted}" },
      "color-brand":   { "$type": "color",      "$value": "{semantic.text.brand}" },
      "color-danger":  { "$type": "color",      "$value": "{semantic.text.status-danger}" },
      "color-inverse": { "$type": "color",      "$value": "{semantic.text.inverse}" },
      "gutter":        { "$type": "dimension",  "$value": "{semantic.spacing.sm}" }
    }
  }
}
