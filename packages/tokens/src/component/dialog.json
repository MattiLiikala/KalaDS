{
  "component": {
    "dialog": {
      "bg":               { "$type": "color",      "$value": "{semantic.bg.default}" },
      "text":             { "$type": "color",      "$value": "{semantic.text.default}" },
      "border":           { "$type": "color",      "$value": "{semantic.border.default}" },
      "border-width":     { "$type": "dimension",  "$value": "{semantic.border-width.default}" },
      "radius":           { "$type": "dimension",  "$value": "{semantic.radius.lg}" },
      "padding":          { "$type": "dimension",  "$value": "{semantic.padding.xl}" },
      "gap":              { "$type": "dimension",  "$value": "{semantic.spacing.md}" },
      "shadow":           { "$type": "shadow",     "$value": "{semantic.shadow.soft.3}" },
      "width-sm":         { "$type": "dimension",  "$value": "{semantic.size.xl}" },
      "width-md":         { "$type": "dimension",  "$value": "{semantic.size.2xl}" },
      "width-lg":         { "$type": "dimension",  "$value": "{semantic.container.md}" },
      "backdrop":         { "$type": "color",      "$value": "{semantic.bg.overlay}" },
      "backdrop-opacity": { "$type": "number",     "$value": "{semantic.opacity.overlay}" }
    }
  }
}
