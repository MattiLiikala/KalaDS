{
  "component": {
    "checkbox": {
      "size":                 { "$type": "dimension",  "$value": "{semantic.spacing.md}" },
      "radius":               { "$type": "dimension",  "$value": "{semantic.radius.sm}" },
      "border-width":         { "$type": "dimension",  "$value": "{semantic.border-width.strong}" },
      "bg":                   { "$type": "color",      "$value": "{semantic.bg.default}" },
      "bg-hover":             { "$type": "color",      "$value": "{semantic.bg.subtle}" },
      "bg-checked":           { "$type": "color",      "$value": "{semantic.bg.interactive}" },
      "bg-checked-hover":     { "$type": "color",      "$value": "{semantic.bg.interactive-hover}" },
      "bg-disabled":          { "$type": "color",      "$value": "{semantic.bg.subtle}" },
      "bg-checked-disabled":  { "$type": "color",      "$value": "{semantic.bg.interactive-disabled}" },
      "border":               { "$type": "color",      "$value": "{semantic.border.control}" },
      "border-hover":         { "$type": "color",      "$value": "{semantic.border.control-hover}" },
      "border-checked":       { "$type": "color",      "$value": "{semantic.border.interactive}" },
      "border-checked-hover": { "$type": "color",      "$value": "{semantic.border.interactive-hover}" },
      "border-disabled":      { "$type": "color",      "$value": "{semantic.border.interactive-disabled}" },
      "check":                { "$type": "color",      "$value": "{semantic.text.on-interactive}" },
      "check-disabled":       { "$type": "color",      "$value": "{semantic.text.on-interactive-disabled}" },
      "label-text":           { "$type": "color",      "$value": "{semantic.text.default}" },
      "label-text-disabled":  { "$type": "color",      "$value": "{semantic.text.muted}" },
      "gap":                  { "$type": "dimension",  "$value": "{semantic.spacing.sm}" },
      "ring-focus":           { "$type": "color",      "$value": "{semantic.ring.interactive-focus}" },
      "ring-width":           { "$type": "dimension",  "$value": "{semantic.border-width.ring}" },
      "ring-offset":          { "$type": "dimension",  "$value": "{semantic.border-width.ring-offset}" }
    }
  }
}
