{
  "component": {
    "card": {
      "bg":            { "$type": "color",     "$value": "{semantic.bg.default}" },
      "bg-hover":      { "$type": "color",     "$value": "{semantic.bg.subtle}" },
      "border":        { "$type": "color",     "$value": "{semantic.border.default}" },
      "border-width":  { "$type": "dimension", "$value": "{semantic.border-width.default}" },
      "radius":        { "$type": "dimension", "$value": "{semantic.radius.lg}" },
      "padding":       { "$type": "dimension", "$value": "{semantic.padding.xl}" },
      "gap":           { "$type": "dimension", "$value": "{semantic.spacing.md}" },
      "shadow-1":         { "$type": "shadow",    "$value": "{semantic.shadow.crisp.1}" },
      "shadow-2":         { "$type": "shadow",    "$value": "{semantic.shadow.crisp.2}" },
      "shadow-3":         { "$type": "shadow",    "$value": "{semantic.shadow.crisp.3}" },
      "offset-hover-1":   { "$type": "dimension", "$value": "{semantic.shadow.crisp-offset.1}" },
      "offset-hover-2":   { "$type": "dimension", "$value": "{semantic.shadow.crisp-offset.2}" },
      "offset-hover-3":   { "$type": "dimension", "$value": "{semantic.shadow.crisp-offset.3}" },
      "shadow-hover":     { "$type": "shadow",    "$value": { "offsetX": "{size.0.px}", "offsetY": "{size.0.px}", "blur": "{size.0.px}", "spread": "{size.0.px}", "color": "{semantic.shadow.crisp-color}" } }
    }
  }
}
