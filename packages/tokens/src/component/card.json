{
  "component": {
    "card": {
      "bg":            { "$type": "color",     "$value": "{semantic.bg.default}" },
      "bg-hover":      { "$type": "color",     "$value": "{semantic.bg.subtle}" },
      "border":        { "$type": "color",     "$value": "{semantic.border.default}" },
      "border-hover":  { "$type": "color",     "$value": "{semantic.border.strong}" },
      "radius":        { "$type": "dimension", "$value": "{semantic.radius.lg}" },
      "padding":       { "$type": "dimension", "$value": "{semantic.padding.xl}" },
      "shadow":        { "$type": "shadow",    "$value": { "offsetX": "0", "offsetY": "1px", "blur": "3px", "spread": "0", "color": "rgba(0,0,0,0.1)" } },
      "shadow-hover":  { "$type": "shadow",    "$value": { "offsetX": "0", "offsetY": "4px", "blur": "12px", "spread": "0", "color": "rgba(0,0,0,0.15)" } }
    }
  }
}
