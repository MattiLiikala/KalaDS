{
  "component": {
    "toggle": {
      "track-width":                { "$type": "dimension",  "$value": "{semantic.spacing.lg}" },
      "track-height":               { "$type": "dimension",  "$value": "{semantic.spacing.md}" },
      "thumb-size":                 { "$type": "dimension",  "$value": "{semantic.spacing.sm}" },
      "border-width":               { "$type": "dimension",  "$value": "{semantic.border-width.strong}" },
      "radius":                     { "$type": "dimension",  "$value": "{semantic.radius.full}" },
      "track-bg":                   { "$type": "color",      "$value": "{semantic.bg.default}" },
      "track-bg-hover":             { "$type": "color",      "$value": "{semantic.bg.subtle}" },
      "track-bg-checked":           { "$type": "color",      "$value": "{semantic.interactive.accent}" },
      "track-bg-checked-hover":     { "$type": "color",      "$value": "{semantic.interactive.accent-hover}" },
      "track-bg-disabled":          { "$type": "color",      "$value": "{semantic.bg.subtle}" },
      "track-border":               { "$type": "color",      "$value": "{semantic.border.control}" },
      "track-border-hover":         { "$type": "color",      "$value": "{semantic.border.control-hover}" },
      "track-border-checked":       { "$type": "color",      "$value": "{semantic.interactive.accent}" },
      "track-border-checked-hover": { "$type": "color",      "$value": "{semantic.interactive.accent-hover}" },
      "track-border-disabled":      { "$type": "color",      "$value": "{semantic.interactive.disabled}" },
      "thumb":                      { "$type": "color",      "$value": "{semantic.interactive.control}" },
      "thumb-hover":                { "$type": "color",      "$value": "{semantic.interactive.control-hover}" },
      "thumb-checked":              { "$type": "color",      "$value": "{semantic.interactive.on-accent}" },
      "thumb-disabled":             { "$type": "color",      "$value": "{semantic.interactive.disabled}" },
      "label-text":                 { "$type": "color",      "$value": "{semantic.text.default}" },
      "label-text-disabled":        { "$type": "color",      "$value": "{semantic.text.muted}" },
      "gap":                        { "$type": "dimension",  "$value": "{semantic.spacing.sm}" },
      "ring-focus":                 { "$type": "color",      "$value": "{semantic.interactive.focus}" },
      "ring-width":                 { "$type": "dimension",  "$value": "{semantic.border-width.ring}" },
      "ring-offset":                { "$type": "dimension",  "$value": "{semantic.border-width.ring-offset}" }
    }
  }
}
