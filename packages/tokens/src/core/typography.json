{
  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": "'Overlock', serif" },
      "base": { "$type": "fontFamily", "$value": "'Overlock', serif" },
      "label": { "$type": "fontFamily", "$value": "'Parkinsans', sans-serif" },
      "section": { "$type": "fontFamily", "$value": "'Parkinsans', sans-serif" }
    },
    "weight": {
      "light": { "$type": "fontWeight", "$value": 300 },
      "normal": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "letterSpacing": {
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.08em" }
    },
    "lineHeight": {
      "small": { "$type": "number", "$value": 1.2 },
      "medium": { "$type": "number", "$value": 1.5 },
      "large": { "$type": "number", "$value": 1.8 }
    },
    "size": {
      "100": { "$type": "dimension", "$value": "0.75rem" },
      "200": { "$type": "dimension", "$value": "0.875rem" },
      "300": { "$type": "dimension", "$value": "1rem" },
      "400": { "$type": "dimension", "$value": "1.25rem" },
      "500": { "$type": "dimension", "$value": "1.5rem" },
      "600": { "$type": "dimension", "$value": "2rem" },
      "700": { "$type": "dimension", "$value": "2.5rem" }
    }
  }
}
