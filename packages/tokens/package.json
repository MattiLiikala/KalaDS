{
  "name": "@kalads/tokens",
  "version": "0.1.0",
  "type": "module",
  "description": "KalaDS design tokens: CSS custom properties, typed CSS variable references for React, JS, JSON and React Native values, in a light and a dark theme.",
  "keywords": [
    "kalads",
    "design-system",
    "design-tokens",
    "css-variables",
    "dark-mode",
    "react-native"
  ],
  "license": "MIT",
  "author": "Matti Liikala",
  "homepage": "https://github.com/MattiLiikala/KalaDS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattiLiikala/KalaDS.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/MattiLiikala/KalaDS/issues"
  },
  "exports": {
    "./css": "./dist/css/variables.css",
    "./js": "./dist/js/tokens.js",
    "./js/dark": "./dist/js/dark.js",
    "./json": "./dist/json/tokens.json",
    "./json/dark": "./dist/json/dark.json",
    "./vars": {
      "types": "./dist/vars/vars.d.ts",
      "default": "./dist/vars/vars.js"
    },
    "./native": {
      "types": "./dist/native/tokens.d.ts",
      "default": "./dist/native/tokens.js"
    }
  },
  "scripts": {
    "build": "node sd.config.mjs",
    "dev": "node sd.config.mjs --watch",
    "test": "node --test test/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "chokidar": "^4.0.0",
    "style-dictionary": "^4.4.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
