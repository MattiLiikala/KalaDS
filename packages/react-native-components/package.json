{
  "name": "@kalads/react-native-components",
  "version": "0.0.0",
  "type": "module",
  "description": "KalaDS components for React Native, styled with the KalaDS design tokens.",
  "keywords": [
    "kalads",
    "design-system",
    "react-native",
    "expo",
    "components",
    "ui"
  ],
  "license": "MIT",
  "author": "Matti Liikala",
  "homepage": "https://github.com/MattiLiikala/KalaDS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattiLiikala/KalaDS.git",
    "directory": "packages/react-native-components"
  },
  "bugs": {
    "url": "https://github.com/MattiLiikala/KalaDS/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./skills/*": "./skills/*"
  },
  "files": [
    "dist",
    "skills",
    "bin"
  ],
  "bin": {
    "kalads-skills": "./bin/kalads-skills.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist",
    "prepack": "node ../../tools/skills/build-skills.mjs --only react-native-components"
  },
  "dependencies": {
    "@kalads/icons": "workspace:*",
    "@kalads/spec": "workspace:*",
    "@kalads/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@expo-google-fonts/overlock": "*",
    "@expo-google-fonts/parkinsans": "*",
    "expo-font": ">=13",
    "react": ">=19",
    "react-native": ">=0.76",
    "react-native-safe-area-context": ">=4.12",
    "react-native-svg": ">=15.8"
  },
  "devDependencies": {
    "@expo-google-fonts/overlock": "^0.4.1",
    "@expo-google-fonts/parkinsans": "^0.4.2",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.0",
    "@types/react": "catalog:",
    "expo": "catalog:",
    "expo-font": "catalog:",
    "jest": "^29.7.0",
    "jest-expo": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
