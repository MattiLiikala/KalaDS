{
  "name": "@kalads/icons",
  "version": "0.2.0",
  "type": "module",
  "description": "KalaDS icons: <kds-icon-*> web components, and icon components for React and React Native.",
  "keywords": [
    "kalads",
    "design-system",
    "icons",
    "web-components",
    "react",
    "react-native"
  ],
  "license": "MIT",
  "author": "Matti Liikala",
  "homepage": "https://kalads.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattiLiikala/KalaDS.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/MattiLiikala/KalaDS/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./*": "./dist/components/*.js"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "node scripts/build-icons.mjs",
    "build": "tsc --project tsconfig.json",
    "dev": "node scripts/build-icons.mjs --watch",
    "clean": "rm -rf dist src/components src/index.ts src/data src/react src/native"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@kalads/tokens": "workspace:*",
    "@types/react": "catalog:",
    "chokidar": "^4.0.0",
    "glob": "^11.0.0",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:",
    "svgo": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@kalads/tokens": "workspace:^",
    "react": ">=19",
    "react-native-svg": ">=15.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
