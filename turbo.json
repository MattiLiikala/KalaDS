{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "*.config.*",
        "scripts/**",
        "*.json",
        "!package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@kalads/web-components#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "*.config.*",
        "*.json",
        "!package.json",
        "!custom-elements.json"
      ],
      "outputs": [
        "dist/**",
        "custom-elements.json"
      ]
    },
    "@kalads/skills-builder#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true,
      "cache": false
    },
    "storybook": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true,
      "cache": false
    },
    "build:storybook": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "*.config.*",
        "jest.config.cjs"
      ]
    },
    "@kalads/skills-builder#test": {
      "dependsOn": [
        "@kalads/skills-builder#build"
      ],
      "inputs": [
        "test/**",
        "templates/**",
        "lib/**",
        "build-skills.mjs"
      ]
    },
    "@kalads/tokens#test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "test/**",
        "src/**",
        "scripts/**",
        "sd.config.mjs"
      ]
    }
  }
}
