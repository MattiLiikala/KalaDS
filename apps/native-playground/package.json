{
  "name": "@kalads/native-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Every React Native component in the states of the Storybook stories, for device and Expo web checks.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web --port 6111",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/overlock": "^0.4.1",
    "@expo-google-fonts/parkinsans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@kalads/icons": "workspace:*",
    "@kalads/react-native-components": "workspace:*",
    "@kalads/tokens": "workspace:*",
    "expo": "catalog:",
    "expo-font": "catalog:",
    "expo-status-bar": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "^6.0.3"
  }
}
